# MCP server development tasks

# Install package in development mode
install:
    uv sync --dev

# Run tests
test:
    uv run pytest -v

# Run tests quietly
test-q:
    uv run pytest -q

# Run tests with coverage
test-cov:
    uv run pytest --cov=homelab_mcp --cov-report=term-missing

# Run the MCP server (for manual testing)
run:
    uv run python -m homelab_mcp.server

# Clean build artifacts and venv
clean:
    rm -rf build/ dist/ *.egg-info .venv/
    find . -type d -name __pycache__ -exec rm -rf {} +
    find . -type f -name "*.pyc" -delete

# Show dependency tree
env:
    uv tree
